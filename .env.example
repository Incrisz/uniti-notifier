# Uniti Pipeline Notifier monitors the database and posts updates to Slack.
# It alerts you the moment the intervention cron job runs (polled every 10 minutes).
# Every 6 hours it sends a snapshot of signal and milestone counts, unchecked milestones, and the last cron run time.

DATABASE_URL=postgresql://user:password@host:port/dbname
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
